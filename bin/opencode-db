#!/bin/sh

set -eu

die() {
  printf 'opencode-db: %s\n' "$*" >&2
  exit 1
}

case ${XDG_DATA_HOME:-} in
  /*) data_home=$XDG_DATA_HOME ;;
  *)
    case ${HOME:-} in
      /*) data_home=$HOME/.local/share ;;
      *) die "XDG_DATA_HOME or HOME must be an absolute path" ;;
    esac
    ;;
esac
checkout="$data_home/mkchad/components/opencode-db"
source_dir="$checkout/src"
package_dir="$source_dir/opencode_db"

[ -d "$package_dir" ] && [ -f "$package_dir/__main__.py" ] \
  || die "deployed source package is unavailable: $package_dir"
command -v python3 >/dev/null 2>&1 || die "python3 is unavailable"
PYTHONPATH= PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
  python3 -P -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' \
  || die "Python 3.11 or newer is required"

PYTHONPATH=$source_dir PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
  exec python3 -P -m opencode_db "$@"
