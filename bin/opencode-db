#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'opencode-db: %s\n' "$*" >&2
  exit 1
}

[[ -n ${HOME:-} && $HOME == /* ]] || die "HOME must be an absolute path"
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
[[ $data_home == /* ]] || die "XDG_DATA_HOME must be an absolute path"
checkout="$data_home/mkchad/components/opencode-db"
source_dir="$checkout/src"
package_dir="$source_dir/opencode_db"

[[ -d $package_dir && -f $package_dir/__main__.py ]] || die "deployed source package is unavailable: $package_dir"
command -v python3 >/dev/null 2>&1 || die "python3 is unavailable"
python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' \
  || die "Python 3.11 or newer is required"

PYTHONPATH=$source_dir exec python3 -m opencode_db "$@"
